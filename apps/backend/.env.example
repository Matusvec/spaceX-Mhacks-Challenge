# Copy to .env (never committed) and fill in.
XAI_API_KEY=
SCENES_DIR=../../scenes
ALLOWED_ORIGINS=http://localhost:5173
# Cluster decoder for /query (text search); the pipelines write it to runs/semantic/ae_decoder.pt.
# AE_DECODER_PATH=models/ae_decoder.pt
# Optional: override the Grok model used to turn chat text into intents.
# XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning
# Optional: Grok Imagine model for POST /concept, and the Grok Voice transcription model and speaking voice.
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_STT_MODEL=grok-voice-transcribe-2.0
# XAI_VOICE_ID=eve
# After adding the key, check all three APIs with: .venv/bin/python smoke_grok.py
