# Leave unset to load bundles from the repo's scenes/ folder via the Vite dev server.
# Set to Matus's laptop (or a tunnel URL) to load bundles from the backend.
# VITE_BACKEND_URL=http://192.168.1.50:8000

# Shared session (SpacetimeDB). Unset: ws://<the page's host>:3000 and the database "pss-studio"
# (a local `spacetime start`). For a two-laptop demo on the hosted cloud, after `spacetime publish`:
# VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
# VITE_SPACETIME_MODULE=pss-studio

# Set only by scripts/deploy_vercel.sh for the hosted build, never in local dev:
# VITE_SAME_ORIGIN=1 calls the Grok routes on the page's own origin under /api; VITE_DEFAULT_SCENE is the scene the bare URL opens.
